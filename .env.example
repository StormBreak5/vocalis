# === Necessárias em runtime (app) — configure também na Vercel ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública canônica do Vocalis usada em links e QR Codes.
# Deve ser uma URL absoluta http/https, sem credenciais, query ou fragmento.
# Subcaminhos são permitidos (ex.: https://example.test/vocalis).
# Na Vercel: a URL de produção (https://<projeto>.vercel.app). Em preview
# deploys, se não configurada, cai para VERCEL_PROJECT_PRODUCTION_URL.
APP_PUBLIC_URL=

# === Sentry (opcional; só ativa monitoramento se preenchido) ===
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=   # só no build (upload de source maps); nunca no runtime

# === Somente testes locais de banco/integração ===
# O app deployado NUNCA lê isto — NÃO configure na Vercel.
# Os scripts de teste puxam este valor de `supabase status` automaticamente;
# só preencha aqui se for rodar testes apontando para um projeto remoto.
SUPABASE_SERVICE_ROLE_KEY=

# URL do emulador Supabase local (usado pelos testes de integração)
# Deixe em branco para usar o padrão: http://127.0.0.1:54321
SUPABASE_URL=
