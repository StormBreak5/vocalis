NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública canônica do Vocalis usada em links e QR Codes.
# Deve ser uma URL absoluta http/https, sem credenciais, query ou fragmento.
# Subcaminhos são permitidos (ex.: https://example.test/vocalis).
APP_PUBLIC_URL=

# URL do emulador Supabase local (usado pelos testes de integração)
# Deixe em branco para usar o padrão: http://127.0.0.1:54321
SUPABASE_URL=
