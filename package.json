{
  "name": "vocalis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": "11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "overrides": {
    "fast-uri": "^3.1.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "app:local:production": "node scripts/app/run-local-production.mjs",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node scripts/supabase/run-vitest-local.mjs integration",
    "test:db": "node scripts/supabase/run-pgtap-local.mjs",
    "test:db:prepare": "node scripts/supabase/manage-local.mjs prepare",
    "test:db:stop": "node scripts/supabase/manage-local.mjs stop",
    "test:ci:environment": "vitest run --config vitest.unit.config.ts scripts/__tests__/e2e-local-environment.test.mjs scripts/__tests__/app-local-production.test.mjs scripts/__tests__/pgtap-runner.test.mjs scripts/__tests__/artifact-sanitizer.test.mjs scripts/__tests__/integration-test-separation.test.mjs",
    "test:app:local:production": "vitest run --config vitest.unit.config.ts scripts/__tests__/app-local-production.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e/run-local.mjs functional",
    "test:e2e:functional": "node scripts/e2e/run-local.mjs functional",
    "test:e2e:chrome": "node scripts/e2e/run-local.mjs functional --project=\"Mobile Chrome\"",
    "test:e2e:webkit": "node scripts/e2e/run-local.mjs functional --project=\"Mobile Safari\"",
    "test:e2e:performance": "node scripts/e2e/run-local.mjs performance --project=\"Mobile Chrome\"",
    "test:e2e:sanitize": "node scripts/e2e/sanitize-artifacts.mjs playwright-report test-results",
    "typecheck": "tsc --noEmit",
    "test:db:race": "node scripts/supabase/run-vitest-local.mjs race"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@sentry/nextjs": "^10.72.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "qr": "^0.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "8.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "pg": "8.22.0",
    "shadcn": "^4.13.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
